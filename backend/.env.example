# CivicPulse AI Environment Configuration
PROJECT_NAME="CivicPulse AI - Smart City Grievance Resolution"
DATABASE_URL="sqlite:///./civicpulse.db"

# LLM Provider Options: 'auto', 'groq', 'openai', or 'anthropic'
LLM_PROVIDER="auto"

# Optional LLM API Keys (If left empty, system operates in intelligent offline heuristic mode seamlessly)
GROQ_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Clustering Parameters
CLUSTER_RADIUS_METERS=100.0
